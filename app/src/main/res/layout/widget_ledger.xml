<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <!-- 第一行：标签 + 日期 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="今日支出"
            android:textColor="#6B7385"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="11/20"
            android:textColor="#9AA3B2"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 主数字 -->
    <TextView
        android:id="@+id/widget_amount"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="0.00"
        android:textColor="#17181B"
        android:textSize="34sp"
        android:textStyle="bold" />

    <!-- 底部两行：本月支出 / 本月收入 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_month_expense"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="本月支出 0.00"
            android:textColor="#6B7385"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_month_income"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="收入 0.00"
            android:textColor="#159B6B"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>